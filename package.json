{
  "name": "nlw-return-impulse-server",
  "version": "1.0.0",
  "description": "API REST do Feedget: recebe feedbacks (bug, ideia, outro) com screenshot, persiste com Prisma e notifica por e-mail.",
  "main": "dist/server.js",
  "author": "Davi Cardoso <davi.almeida.c@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.1",
    "nodemailer": "^6.7.5"
  },
  "devDependencies": {
    "@swc/core": "^1.2.183",
    "@swc/jest": "^0.2.21",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.1",
    "@types/node": "^17.0.31",
    "@types/nodemailer": "^6.4.4",
    "jest": "^28.1.0",
    "prisma": "^3.13.0",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.6.4"
  },
  "allowScripts": {
    "prisma@3.13.0": true,
    "@prisma/client@3.13.0": true,
    "@prisma/engines@3.13.0-17.efdf9b1183dddfd4258cd181a72125755215ab7b": true
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "jest",
    "solid",
    "nlw"
  ]
}
